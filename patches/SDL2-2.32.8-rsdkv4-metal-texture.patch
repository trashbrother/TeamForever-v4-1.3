 @implementation METAL_TextureData
 @end
 
+void *SDLCALL SDL_RenderGetMetalTexture(SDL_Texture *texture)
+{
+    METAL_TextureData *texturedata;
+
+    @autoreleasepool {
+        if (texture == NULL) {
+            return NULL;
+        }
+
+        if (texture->native != NULL) {
+            texture = texture->native;
+        }
+
+        if (texture->driverdata == NULL) {
+            return NULL;
+        }
+
+        texturedata = (__bridge METAL_TextureData *)texture->driverdata;
+
+        if (texturedata.mtltexture == nil) {
+            return NULL;
+        }
+
+        return (__bridge void *)texturedata.mtltexture;
+    }
+}
