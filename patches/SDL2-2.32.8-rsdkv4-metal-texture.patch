+void *SDLCALL SDL_RenderGetMetalCommandBuffer(SDL_Renderer *renderer)
+{
+    METAL_RenderData *data;
+
+    @autoreleasepool {
+        if (renderer == NULL || renderer->driverdata == NULL) {
+            return NULL;
+        }
+
+        METAL_ActivateRenderCommandEncoder(renderer, MTLLoadActionLoad, NULL, nil);
+        data = (__bridge METAL_RenderData *)renderer->driverdata;
+
+        if (data.mtlcmdbuffer == nil) {
+            return NULL;
+        }
+
+        return (__bridge void *)data.mtlcmdbuffer;
+    }
+}
+
+void *SDLCALL SDL_RenderGetMetalRenderTargetTexture(SDL_Renderer *renderer)
+{
+    METAL_RenderData *data;
+
+    @autoreleasepool {
+        if (renderer == NULL || renderer->driverdata == NULL) {
+            return NULL;
+        }
+
+        data = (__bridge METAL_RenderData *)renderer->driverdata;
+
+        if (data.mtlpassdesc.colorAttachments[0].texture == nil) {
+            return NULL;
+        }
+
+        return (__bridge void *)data.mtlpassdesc.colorAttachments[0].texture;
+    }
+}
+
+void SDLCALL SDL_RenderEndMetalCommandEncoder(SDL_Renderer *renderer)
+{
+    METAL_RenderData *data;
+
+    @autoreleasepool {
+        if (renderer == NULL || renderer->driverdata == NULL) {
+            return;
+        }
+
+        data = (__bridge METAL_RenderData *)renderer->driverdata;
+
+        if (data.mtlcmdencoder != nil) {
+            [data.mtlcmdencoder endEncoding];
+            data.mtlcmdencoder = nil;
+        }
+    }
+}
+
+int SDLCALL SDL_RenderResumeMetalCommandEncoder(SDL_Renderer *renderer)
+{
+    METAL_RenderData *data;
+
+    @autoreleasepool {
+        if (renderer == NULL || renderer->driverdata == NULL) {
+            return -1;
+        }
+
+        data = (__bridge METAL_RenderData *)renderer->driverdata;
+
+        if (data.mtlcmdencoder != nil) {
+            return 0;
+        }
+
+        if (data.mtlcmdbuffer == nil ||
+            data.mtlpassdesc.colorAttachments[0].texture == nil) {
+            return -1;
+        }
+
+        data.mtlpassdesc.colorAttachments[0].loadAction = MTLLoadActionLoad;
+
+        data.mtlcmdencoder =
+            [data.mtlcmdbuffer
+                renderCommandEncoderWithDescriptor:data.mtlpassdesc];
+
+        if (data.mtlcmdencoder == nil) {
+            return -1;
+        }
+
+        data.mtlcmdencoder.label = @"SDL metal renderer resumed backbuffer";
+
+        return 0;
+    }
+}
